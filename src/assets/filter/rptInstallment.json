{
  "width": 700,
  "height": 500,
  "control": [
    [
      {
        "name": "tu_ngay",
        "label": "Từ ngày",
        "type": "date",
        "dataFormatString": "datetimeFormat",
        "class": "basis-1/3",
        "required": true,
        "value": "new Date()"
      },
      {
        "name": "den_ngay",
        "label": "Đến ngày",
        "type": "date",
        "dataFormatString": "datetimeFormat",
        "class": "basis-1/3",
        "required": true,
        "value": "new Date()"
      }
    ],
    [
      {
        "name": "ma_cuahang",
        "label": "Mã cửa hàng",
        "isLookup": "true",
        "control": "zcdmcuahang",
        "value": "@@shop",
        "dataFormatString": "uppercaseFormat",
        "reference": ["ma_cuahang"],
        "isChoose": true
      }
    ],
    [
      {
        "name": "ma_ca",
        "label": "Mã ca",
        "isLookup": "true",
        "control": "dmca",
        "dataFormatString": "uppercaseFormat",
        "reference": ["ma_ca", "ten_ca"],
        "class": "basis-1/3"
      },
      {
        "name": "ten_ca",
        "label": "Tên ca",
        "disabled": true,
        "isExternalField": true,
        "class": "flex-1"
      }
    ],
    [
      {
        "name": "ma_kh",
        "label": "Mã khách",
        "isLookup": "true",
        "control": "dmkh",
        "dataFormatString": "uppercaseFormat",
        "reference": ["ma_kh"]
      }
    ],
    [
      {
        "name": "ma_dvtg",
        "label": "Đơn vị trả góp",
        "isLookup": "true",
        "control": "dmdvtg",
        "dataFormatString": "uppercaseFormat",
        "reference": ["ma_kh"],
        "class": "flex-1",
        "mapper": {
          "ma_kh": "ma_dvtg"
        }
      }
    ]
  ]
}
